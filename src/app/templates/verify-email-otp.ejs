<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify Your Email</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f6f8;
      font-family: Arial, Helvetica, sans-serif;
    "
  >
    <div
      style="
        max-width: 600px;
        margin: 40px auto;
        background-color: #ffffff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
      "
    >
      <!-- Header -->
      <div
        style="
          background-color: #111827;
          padding: 30px 20px;
          text-align: center;
        "
      >
        <h1
          style="margin: 0; color: #ffffff; font-size: 24px; font-weight: 600"
        >
          Verify Your Email
        </h1>
      </div>

      <!-- Content -->
      <div style="padding: 40px 30px; text-align: center">
        <div
          style="
            width: 64px;
            height: 64px;
            margin: 0 auto 20px;
            background-color: #eff6ff;
            border-radius: 50%;
            line-height: 64px;
            font-size: 30px;
          "
        >
          ✉
        </div>

        <h2 style="margin: 0 0 15px; color: #111827; font-size: 22px">
          Confirm Your Email Address
        </h2>

        <p
          style="
            max-width: 450px;
            margin: 0 auto 25px;
            color: #6b7280;
            font-size: 15px;
            line-height: 1.6;
          "
        >
          Thank you for creating an account with us. Please enter the
          verification code below to confirm your email address.
        </p>

        <!-- OTP -->
        <div
          style="
            display: inline-block;
            margin: 10px 0 20px;
            padding: 18px 35px;
            background-color: #f3f4f6;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
          "
        >
          <span
            style="
              color: #111827;
              font-size: 32px;
              font-weight: 700;
              letter-spacing: 8px;
            "
          >
            <%= otp %>
          </span>
        </div>

        <p style="margin: 5px 0 25px; color: #6b7280; font-size: 14px">
          This verification code will expire in
          <strong>5 minutes</strong>.
        </p>

        <!-- Security Notice -->
        <div
          style="
            padding: 15px;
            background-color: #fff7ed;
            border: 1px solid #fed7aa;
            border-radius: 8px;
            text-align: left;
          "
        >
          <p
            style="margin: 0; color: #9a3412; font-size: 13px; line-height: 1.5"
          >
            <strong>Security Notice:</strong>
            Never share this verification code with anyone. Our team will never
            ask you for your OTP.
          </p>
        </div>
      </div>

      <!-- Footer -->
      <div
        style="
          padding: 20px 30px;
          background-color: #f9fafb;
          border-top: 1px solid #e5e7eb;
          text-align: center;
        "
      >
        <p style="margin: 0 0 8px; color: #6b7280; font-size: 13px">
          If you didn't create an account or request this code, you can safely
          ignore this email.
        </p>

        <p style="margin: 0; color: #9ca3af; font-size: 12px">
          © 2026 Your Company. All rights reserved.
        </p>
      </div>
    </div>
  </body>
</html>
