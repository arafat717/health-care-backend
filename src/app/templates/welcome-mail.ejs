<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Welcome to Book Doctor</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f7f9;
      font-family: Arial, Helvetica, sans-serif;
    "
  >
    <div
      style="
        max-width: 600px;
        margin: 40px auto;
        background-color: #ffffff;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
      "
    >
      <!-- Header -->
      <div
        style="
          background-color: #0f766e;
          padding: 30px 20px;
          text-align: center;
        "
      >
        <h1
          style="margin: 0; color: #ffffff; font-size: 28px; font-weight: 700"
        >
          Book Doctor
        </h1>

        <p style="margin: 8px 0 0; color: #d1fae5; font-size: 14px">
          Your healthcare, made easier.
        </p>
      </div>

      <!-- Content -->
      <div style="padding: 40px 30px; text-align: center">
        <!-- Welcome Icon -->
        <div
          style="
            width: 70px;
            height: 70px;
            margin: 0 auto 22px;
            background-color: #ecfdf5;
            border-radius: 50%;
            line-height: 70px;
            font-size: 34px;
          "
        >
          👋
        </div>

        <h2 style="margin: 0 0 15px; color: #111827; font-size: 24px">
          Welcome to Book Doctor!
        </h2>

        <p
          style="
            margin: 0 auto 25px;
            max-width: 470px;
            color: #4b5563;
            font-size: 15px;
            line-height: 1.7;
          "
        >
          We're happy to have you with us. Your account has been successfully
          created and your email has been verified.
        </p>

        <!-- Success Box -->
        <div
          style="
            margin: 25px 0;
            padding: 18px;
            background-color: #ecfdf5;
            border: 1px solid #a7f3d0;
            border-radius: 10px;
          "
        >
          <p
            style="margin: 0; color: #047857; font-size: 14px; line-height: 1.6"
          >
            <strong>Your account is ready!</strong><br />
            You can now log in and start using Book Doctor.
          </p>
        </div>

        <p
          style="
            margin: 25px auto;
            max-width: 460px;
            color: #6b7280;
            font-size: 14px;
            line-height: 1.7;
          "
        >
          With Book Doctor, you can easily find doctors, explore healthcare
          services, and manage your appointments from one convenient platform.
        </p>

        <!-- Button -->
        <a
          href="#"
          style="
            display: inline-block;
            padding: 14px 28px;
            background-color: #0f766e;
            color: #ffffff;
            text-decoration: none;
            font-size: 15px;
            font-weight: 600;
            border-radius: 8px;
          "
        >
          Go to Book Doctor
        </a>

        <p
          style="
            margin: 30px 0 0;
            color: #9ca3af;
            font-size: 13px;
            line-height: 1.5;
          "
        >
          Thank you for choosing Book Doctor. We're here to make your healthcare
          journey simpler.
        </p>
      </div>

      <!-- Footer -->
      <div
        style="
          padding: 22px 30px;
          background-color: #f9fafb;
          border-top: 1px solid #e5e7eb;
          text-align: center;
        "
      >
        <p style="margin: 0 0 8px; color: #6b7280; font-size: 13px">
          This is an automated email. Please do not reply to this message.
        </p>

        <p style="margin: 0; color: #9ca3af; font-size: 12px">
          © 2026 Book Doctor. All rights reserved.
        </p>
      </div>
    </div>
  </body>
</html>
